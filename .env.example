# DhanHQ API credentials (https://dhanhq.co/docs/)
DHAN_CLIENT_ID=

# --- Access token ----------------------------------------------------------
# Dhan access tokens expire every 24 hours. TOTP auto-login (recommended) lets
# the app mint and refresh the token itself — fully hands-off, no daily action.
# Enable TOTP on web.dhan.co (DhanHQ Trading APIs -> Setup TOTP), then set:
DHAN_PIN=
DHAN_TOTP_SECRET=

# Fallback: paste a token generated from web.dhan.co (expires in 24h).
# DHAN_ACCESS_TOKEN=

# Production (default):
DHAN_API_BASE=https://api.dhan.co
# Sandbox:
# DHAN_API_BASE=https://sandbox.dhan.co

# Advanced: override the Dhan auth host (defaults to https://auth.dhan.co).
# DHAN_AUTH_BASE=https://auth.dhan.co
