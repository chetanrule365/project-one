# DhanHQ API credentials (https://dhanhq.co/docs/)
DHAN_CLIENT_ID=
DHAN_TOTP_SECRET=
# Dhan PIN is entered on /login and stored encrypted in an httpOnly cookie.
DHAN_API_BASE=https://api.dhan.co

# MongoDB Atlas free cluster. Atlas → Network Access → allow 0.0.0.0/0.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=project-one

# Encrypts the PIN cookie and the Dhan token in MongoDB. Same value on Railway.
SESSION_SECRET=

# Laptop only: public Railway URL so backtests run in the cloud.
CLOUD_APP_URL=https://your-service.up.railway.app
# Same random secret on local .env and Railway.
CLOUD_WORKER_SECRET=
