# DhanHQ API credentials (https://dhanhq.co/docs/)
DHAN_CLIENT_ID=

# --- Access token: pick ONE of the options below ---------------------------
# Dhan access tokens expire every 24 hours. Rather than pasting a new token
# each day, prefer TOTP auto-login (Option A) so the app refreshes it itself.

# Option A (recommended): TOTP auto-login — fully hands-off, no daily action.
# Enable TOTP on web.dhan.co (DhanHQ Trading APIs -> Setup TOTP), then set:
DHAN_PIN=
DHAN_TOTP_SECRET=

# Option B: "Login with Dhan" (OAuth) — one-click browser login from Settings.
# Create an API key on web.dhan.co with Redirect URL <app-url>/settings/dhan-callback
# Either DHAN_APP_ID / DHAN_APP_SECRET or DHAN_API_ID / DHAN_API_SECRET works.
# DHAN_API_ID=
# DHAN_API_SECRET=

# Option C (legacy/manual): paste a token here or on the in-app Settings page.
# DHAN_ACCESS_TOKEN=

# Production (default):
DHAN_API_BASE=https://api.dhan.co
# Sandbox:
# DHAN_API_BASE=https://sandbox.dhan.co

# Advanced: override the Dhan auth host (defaults to https://auth.dhan.co).
# DHAN_AUTH_BASE=https://auth.dhan.co
