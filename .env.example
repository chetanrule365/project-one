# DhanHQ API credentials (https://dhanhq.co/docs/v2/authentication/)
# DHAN_CLIENT_ID: numeric client id from My Profile → Access DhanHQ APIs
# DHAN_ACCESS_TOKEN: the JWT Access Token (long, three parts, expires ~24h).
# Do not paste API key or API secret here — those are not accepted by marketfeed.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Production (default):
DHAN_API_BASE=https://api.dhan.co
# Sandbox:
# DHAN_API_BASE=https://sandbox.dhan.co
